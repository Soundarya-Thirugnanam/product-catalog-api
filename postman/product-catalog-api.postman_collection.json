                  "pm.test('status updated', () => pm.expect(json.status).to.eql('INACTIVE'));",
                  "pm.test('createdBy unchanged by update', () => pm.expect(json.createdBy).to.eql('alice'));",
                  "pm.test('updatedBy reflects new X-User-Name header', () => pm.expect(json.updatedBy).to.eql('bob'));"
                ]
              }
            }
          ]
