    {
      "name": "4 - Update Product",
      "item": [
        {
          "name": "Update product -> 200",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Name", "value": "bob" }
            ],
            "url": "{{baseUrl}}/api/v1/products/{{productId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Wireless Mouse Pro\",\"description\":\"Ergonomic wireless mouse, now with a faster sensor\",\"price\":24.99,\"status\":\"INACTIVE\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
