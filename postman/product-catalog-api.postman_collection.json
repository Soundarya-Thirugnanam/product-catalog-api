{
  "info": {
    "name": "Product Catalog API",
    "description": "Full CRUD + validation + error-handling scenario coverage for the Product Catalog API. Covers the optional `description` field, unique product names, `X-User-Name`-driven audit fields (createdBy/updatedBy/createdOn/updatedOn) and the `/audit` change-history endpoint. Run the whole collection top-to-bottom against a freshly restarted app (in-memory H2 is wiped on restart) so the '0 - Empty List' folder sees a genuinely empty catalog.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "productId", "value": "" },
    { "key": "tempProductId", "value": "" },
    { "key": "uniqueProductAId", "value": "" },
    { "key": "uniqueProductBId", "value": "" }
  ],
  "item": [
    {
      "name": "0 - Empty List Scenario",
      "item": [
        {
          "name": "List products on empty catalog -> 204",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204 No Content', () => pm.response.to.have.status(204));",
                  "pm.test('Body is empty', () => pm.expect(pm.response.text()).to.eql(''));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 - Create Product",
      "item": [
        {
          "name": "Create product -> 201",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Name", "value": "alice" }
            ],
            "url": "{{baseUrl}}/api/v1/products",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Wireless Mouse\",\"description\":\"Ergonomic wireless mouse with USB receiver\",\"price\":19.99,\"status\":\"ACTIVE\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Location header points to the new resource', () => pm.expect(pm.response.headers.get('Location')).to.include('/api/v1/products/'));",
                  "const json = pm.response.json();",
                  "pm.test('Response has generated id', () => pm.expect(json.id).to.be.a('string'));",
                  "pm.test('name matches request', () => pm.expect(json.name).to.eql('Wireless Mouse'));",
                  "pm.test('description matches request', () => pm.expect(json.description).to.eql('Ergonomic wireless mouse with USB receiver'));",
                  "pm.test('status matches request', () => pm.expect(json.status).to.eql('ACTIVE'));",
                  "pm.test('createdBy reflects X-User-Name header', () => pm.expect(json.createdBy).to.eql('alice'));",
                  "pm.test('updatedBy reflects X-User-Name header', () => pm.expect(json.updatedBy).to.eql('alice'));",
                  "pm.test('createdOn is present', () => pm.expect(json.createdOn).to.be.a('string'));",
                  "pm.test('updatedOn is present', () => pm.expect(json.updatedOn).to.be.a('string'));",
                  "pm.collectionVariables.set('productId', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product with no description -> 201 (description is optional)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/products",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"No Description Product\",\"price\":15.00,\"status\":\"ACTIVE\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('description is null when omitted', () => pm.expect(json.description).to.be.null);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product with blank name -> 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/products",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\" \",\"price\":10.00,\"status\":\"ACTIVE\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
                  "const json = pm.response.json();",
                  "pm.test('fieldErrors.name present', () => pm.expect(json.fieldErrors.name).to.eql('name must not be blank'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product with null name, price, status -> 400 (all fields)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/products",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":null,\"price\":null,\"status\":null}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
                  "const json = pm.response.json();",
                  "pm.test('fieldErrors.name present', () => pm.expect(json.fieldErrors).to.have.property('name'));",
                  "pm.test('fieldErrors.price present', () => pm.expect(json.fieldErrors).to.have.property('price'));",
                  "pm.test('fieldErrors.status present', () => pm.expect(json.fieldErrors).to.have.property('status'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product with description over 1000 characters -> 400",
