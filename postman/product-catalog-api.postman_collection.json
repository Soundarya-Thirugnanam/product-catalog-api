                  "const json = pm.response.json();",
                  "pm.test('fieldErrors.price present', () => pm.expect(json.fieldErrors.price).to.eql('price must be greater than zero'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product with negative price -> 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/products",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Widget\",\"price\":-5,\"status\":\"ACTIVE\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
                  "const json = pm.response.json();",
                  "pm.test('fieldErrors.price present', () => pm.expect(json.fieldErrors.price).to.eql('price must be greater than zero'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product with malformed JSON body -> 400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/products",
            "body": {
              "mode": "raw",
              "raw": "{not valid json"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
                  "const json = pm.response.json();",
                  "pm.test('message explains malformed body', () => pm.expect(json.message).to.eql('Malformed request body'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 - Get Product By Id",
      "item": [
        {
          "name": "Get product by id -> 200",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('id matches requested id', () => pm.expect(json.id).to.eql(pm.collectionVariables.get('productId')));",
                  "pm.test('createdBy carried over from creation', () => pm.expect(json.createdBy).to.eql('alice'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get product by unknown id -> 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/{{$guid}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404 Not Found', () => pm.response.to.have.status(404));",
                  "const json = pm.response.json();",
                  "pm.test('message explains not found', () => pm.expect(json.message).to.include('Product not found with id'));"
                ]
              }
            }
          ]
        }
      ]
    },
