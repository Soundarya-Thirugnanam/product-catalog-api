    {
      "name": "5 - Product Name Uniqueness",
      "item": [
        {
          "name": "Create product A for uniqueness test -> 201",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/products",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Unique Test Product A\",\"description\":\"First uniqueness test product\",\"price\":5.00,\"status\":\"ACTIVE\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('uniqueProductAId', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product B for uniqueness test -> 201",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/products",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Unique Test Product B\",\"description\":\"Second uniqueness test product\",\"price\":6.00,\"status\":\"ACTIVE\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('uniqueProductBId', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product with duplicate name -> 409",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/products",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Unique Test Product A\",\"description\":\"Attempted duplicate\",\"price\":7.00,\"status\":\"ACTIVE\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409 Conflict', () => pm.response.to.have.status(409));",
                  "const json = pm.response.json();",
                  "pm.test('message explains the duplicate name', () => pm.expect(json.message).to.eql('Product name already exists: Unique Test Product A'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update product with another product's name -> 409",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/products/{{uniqueProductBId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Unique Test Product A\",\"description\":\"Trying to steal a name\",\"price\":6.00,\"status\":\"ACTIVE\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409 Conflict', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update product keeping its own name -> 200",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/products/{{uniqueProductAId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Unique Test Product A\",\"description\":\"Updated but same name\",\"price\":5.50,\"status\":\"INACTIVE\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK (self-rename is allowed)', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('name unchanged', () => pm.expect(json.name).to.eql('Unique Test Product A'));",
                  "pm.test('status updated', () => pm.expect(json.status).to.eql('INACTIVE'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6 - Product Audit History",
      "item": [
        {
          "name": "Get audit history for product -> 200 (CREATED + UPDATED)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/{{productId}}/audit"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('history has one entry per change', () => pm.expect(json.length).to.eql(2));",
                  "pm.test('most recent entry is the update', () => pm.expect(json[0].action).to.eql('UPDATED'));",
                  "pm.test('most recent entry was performed by bob', () => pm.expect(json[0].performedBy).to.eql('bob'));",
                  "pm.test('oldest entry is the creation', () => pm.expect(json[1].action).to.eql('CREATED'));",
                  "pm.test('oldest entry was performed by alice', () => pm.expect(json[1].performedBy).to.eql('alice'));",
                  "pm.test('entries carry the product id', () => pm.expect(json[0].productId).to.eql(pm.collectionVariables.get('productId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get audit history for unknown product -> 200 empty array",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/{{$guid}}/audit"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('history is empty', () => pm.expect(json.length).to.eql(0));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "7 - Delete Product",
      "item": [
        {
          "name": "Create temp product for delete scenario -> 201",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/products",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Temp Delete Target\",\"price\":1.00,\"status\":\"ACTIVE\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('tempProductId', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete product -> 204",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/products/{{tempProductId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get deleted product -> 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/{{tempProductId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get audit history after delete -> 200 still shows full history",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/products/{{tempProductId}}/audit"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK (main table row is gone, audit history survives)', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('history has CREATED and DELETED entries', () => pm.expect(json.length).to.eql(2));",
                  "pm.test('most recent entry is the deletion', () => pm.expect(json[0].action).to.eql('DELETED'));",
                  "pm.test('oldest entry is the creation', () => pm.expect(json[1].action).to.eql('CREATED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete unknown product -> 404",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/products/{{$guid}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
